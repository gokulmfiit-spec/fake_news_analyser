# Django
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (leave DB_ENGINE=sqlite for zero-config local dev)
DB_ENGINE=sqlite
DB_NAME=fakenews_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM
# Any Anthropic-compatible key. If left blank, the system falls back to the
# built-in heuristic + ML classifier only (no LLM verdict/summary).
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-6

# Optional trusted news API (e.g. NewsAPI.org). Leave blank to skip.
TRUSTED_NEWS_API_KEY=
TRUSTED_NEWS_API_URL=https://newsapi.org/v2/everything
